# Configuração do robô de WhatsApp (copie para .env e preencha)

# --- Cérebro (mesmo servidor) ---
CEREBRO_URL=http://127.0.0.1:8000
CEREBRO_TOKEN=coloque-aqui-a-mesma-SEGREDO-do-cerebro

# --- Evolution API (WhatsApp, mesmo servidor) ---
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_KEY=coloque-aqui-a-apikey-da-evolution
EVOLUTION_INSTANCE=fabrica

# --- Link do briefing (o artifact público que o cliente preenche) ---
BRIEFING_URL=https://...

# Mensagem é opcional (tem um padrão embutido). Use {nome} e {link}.
# MSG_BRIEFING=Oii, {nome}! ... {link} ...
