# Copie para ".env" no servidor e preencha. NÃO suba o .env pro GitHub (tem segredo).

# senha que a Fábrica usa pra puxar os leads (invente uma forte e use a mesma na Fábrica)
SEGREDO=troque-por-uma-senha-forte

# endereço público do cérebro (o domínio/túnel que vamos configurar na Oracle)
BASE_URL=https://cerebro.seudominio.com.br

# Stripe (pegue no painel do Stripe -> Desenvolvedores -> Chaves de API)
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# preço em centavos (9700 = R$ 97,00)
PRECO_CENTAVOS=9700

# onde o banco SQLite fica (opcional)
# CEREBRO_DB=/home/ubuntu/cerebro/cerebro.db
