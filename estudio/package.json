{
  "name": "fabrica-de-lps-estudio",
  "version": "1.0.0",
  "description": "Open Design — app de desktop",
  "author": "Open Design",
  "repository": "https://github.com/isatdpmdesign/fabrica-lps",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "onnxruntime-node": "1.20.1",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fabricadelps.estudio",
    "productName": "Open Design",
    "asar": false,
    "files": [
      "desktop/**",
      "app/**",
      "templates/**",
      "build/icon.*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "instaladores"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "isatdpmdesign",
        "repo": "fabrica-lps",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Open Design",
      "artifactName": "Open-Design-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Graphics"
    }
  }
}
